#pragma code_page(65001)
#include <windows.h>
#include "settings.h"
IDD_SETTINGS DIALOGEX 0, 0, 340, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MyZoomIt 设置"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "标注快捷键", -1, 14, 14, 100, 12
    CONTROL "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 14, 32, 208, 18
    PUSHBUTTON "恢复默认", IDC_RESET, 232, 32, 94, 18
    LTEXT "点击输入框并按组合键，需包含 Ctrl 或 Alt，可加 Shift。", -1, 14, 57, 312, 22
    LTEXT "", IDC_ERROR, 14, 82, 312, 25
    GROUPBOX "操作说明", -1, 14, 112, 312, 120
    LTEXT "快捷键：开始 / 结束标注；Esc：结束标注。\n鼠标左键、触控笔或手指：绘制；触控笔支持压感。\nCtrl + 滚轮：调整粗细（1–24，默认 12）。\nCtrl + Z：撤销上一笔；C：清空全部笔迹。\nR 红色 · G 绿色 · O 橙色 · P 粉紫色\nB 蓝色 · W 白色 · Y 黄色\n结束标注时清空笔迹，重新进入保留颜色和粗细。", -1, 24, 127, 292, 96
    LTEXT "保存后立即生效，下次启动继续使用。", -1, 14, 245, 188, 20
    DEFPUSHBUTTON "保存", IDOK, 204, 247, 56, 20
    PUSHBUTTON "取消", IDCANCEL, 270, 247, 56, 20
END
