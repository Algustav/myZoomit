#pragma code_page(65001)
#include <windows.h>
#include "settings.h"
#include "version.h"
IDI_APP ICON "assets/myzoomit.ico"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MyZoomIt screen annotation"
            VALUE "FileVersion", MYZOOMIT_VERSION
            VALUE "ProductName", "MyZoomIt"
            VALUE "ProductVersion", MYZOOMIT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
IDD_SETTINGS DIALOGEX 0, 0, 330, 346
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MyZoomIt v2.0 设置"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP, 10, 10, 310, 260
    LTEXT "缩放快捷键", IDC_ZOOM_HOTKEY_LABEL, 22, 34, 64, 18, SS_CENTERIMAGE
    CONTROL "", IDC_SNAPSHOT_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 94, 34, 140, 18
    PUSHBUTTON "删除", IDC_SNAPSHOT_DELETE, 248, 34, 58, 18
    LTEXT "标注快捷键", IDC_DRAW_HOTKEY_LABEL, 22, 34, 64, 18, SS_CENTERIMAGE
    CONTROL "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 94, 34, 140, 18
    PUSHBUTTON "删除", IDC_DELETE_HOTKEY, 248, 34, 58, 18
    LTEXT "缩放倍率 (%)", IDC_ZOOM_LABEL, 22, 62, 58, 24, SS_CENTERIMAGE
    CONTROL "", IDC_SNAPSHOT_ZOOM, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 62, 156, 24
    LTEXT "200%", IDC_SNAPSHOT_ZOOM_VALUE, 266, 62, 34, 24, SS_CENTERIMAGE
    LTEXT "默认笔宽 (px)", IDC_WIDTH_LABEL, 22, 62, 58, 24, SS_CENTERIMAGE
    CONTROL "", IDC_DEFAULT_WIDTH, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 62, 156, 24
    LTEXT "8 px", IDC_DEFAULT_WIDTH_VALUE, 266, 62, 34, 24, SS_CENTERIMAGE
    LTEXT "计时快捷键", IDC_TIMER_HOTKEY_LABEL, 22, 34, 64, 18, SS_CENTERIMAGE
    CONTROL "", IDC_TIMER_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 94, 34, 140, 18
    PUSHBUTTON "删除", IDC_TIMER_DELETE, 248, 34, 58, 18
    LTEXT "默认时长 (分钟)", IDC_TIMER_MINUTES_LABEL, 22, 58, 72, 18, SS_CENTERIMAGE
    EDITTEXT IDC_TIMER_MINUTES, 94, 58, 60, 18, ES_NUMBER | WS_TABSTOP | WS_BORDER
    LTEXT "显示样式", IDC_TIMER_STYLE_LABEL, 22, 82, 64, 18, SS_CENTERIMAGE
    COMBOBOX IDC_TIMER_STYLE, 94, 82, 212, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "默认模式", IDC_TIMER_SHAPE_LABEL, 22, 106, 64, 18, SS_CENTERIMAGE
    COMBOBOX IDC_TIMER_SHAPE, 94, 106, 212, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX "操作说明", IDC_INSTRUCTION_GROUP, 22, 100, 284, 120
    LTEXT "", IDC_INSTRUCTIONS, 30, 114, 268, 100, SS_NOPREFIX
    GROUPBOX "关于", IDC_ABOUT_GROUP, 22, 32, 244, 200
    LTEXT "", IDC_ABOUT_TEXT, 32, 44, 224, 24, SS_NOPREFIX
    CONTROL "项目：<a href=""https://github.com/Algustav/myZoomit"">https://github.com/Algustav/myZoomit</a>", IDC_PROJECT_LINK, "SysLink", WS_TABSTOP, 32, 76, 224, 12
    CONTROL "联系：<a href=""mailto:mail@ganlei.com"">mail@ganlei.com</a>", IDC_CONTACT_LINK, "SysLink", WS_TABSTOP, 32, 88, 224, 12
    LTEXT "语言：C++     协议：MIT", IDC_ABOUT_LICENSE, 32, 100, 224, 12
    CONTROL "致谢：<a href=""https://github.com/steveruizok/perfect-freehand"">https://github.com/steveruizok/perfect-freehand</a>", IDC_CREDITS_LINK, "SysLink", WS_TABSTOP, 32, 116, 224, 12
    CONTROL "", IDC_COFFEE_IMAGE, "STATIC", SS_OWNERDRAW, 32, 132, 56, 64
    LTEXT "请我喝杯生椰拿铁", IDC_COFFEE_CAPTION, 32, 200, 224, 12
    LTEXT "by 甘磊 & codex 2026", IDC_ABOUT_AUTHOR, 32, 216, 224, 12, SS_NOPREFIX
    AUTOCHECKBOX "显示悬浮状态菜单", IDC_SHOW_HINT, 12, 278, 160, 14
    AUTOCHECKBOX "开机自动运行", IDC_STARTUP, 190, 278, 124, 14
    AUTOCHECKBOX "鼠标强调（按 Ctrl 显示位置，系统全局设置）", IDC_MOUSE_EMPHASIS, 12, 296, 306, 14
    DEFPUSHBUTTON "保存", IDOK, 186, 318, 58, 20
    PUSHBUTTON "取消", IDCANCEL, 258, 318, 60, 20
END
IDD_ABOUT DIALOGEX 0, 0, 264, 242
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 myZoomit"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "关于", IDC_ABOUT_GROUP, 10, 8, 244, 200
    LTEXT "", IDC_ABOUT_TEXT, 20, 20, 224, 24, SS_NOPREFIX
    CONTROL "项目：<a href=""https://github.com/Algustav/myZoomit"">https://github.com/Algustav/myZoomit</a>", IDC_PROJECT_LINK, "SysLink", WS_TABSTOP, 20, 52, 224, 12
    CONTROL "联系：<a href=""mailto:mail@ganlei.com"">mail@ganlei.com</a>", IDC_CONTACT_LINK, "SysLink", WS_TABSTOP, 20, 64, 224, 12
    LTEXT "语言：C++     协议：MIT", -1, 20, 76, 224, 12
    CONTROL "致谢：<a href=""https://github.com/steveruizok/perfect-freehand"">https://github.com/steveruizok/perfect-freehand</a>", IDC_CREDITS_LINK, "SysLink", WS_TABSTOP, 20, 92, 224, 12
    CONTROL "", IDC_COFFEE_IMAGE, "STATIC", SS_OWNERDRAW, 20, 108, 56, 64
    LTEXT "请我喝杯生椰拿铁", IDC_COFFEE_CAPTION, 20, 176, 224, 12
    LTEXT "by 甘磊 & codex 2026", IDC_ABOUT_AUTHOR, 20, 192, 224, 12, SS_NOPREFIX
    DEFPUSHBUTTON "关闭", IDOK, 198, 216, 56, 18
END

IDB_COFFEE BITMAP "../assets/acoffee.bmp"

IDD_TIMER_SETTINGS DIALOGEX 0, 0, 280, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "倒计时与时钟设置"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "计时快捷键", -1, 12, 14, 66, 18, SS_CENTERIMAGE
    CONTROL "", IDC_TIMER_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 82, 14, 120, 18
    PUSHBUTTON "删除", IDC_TIMER_DELETE, 212, 14, 52, 18
    LTEXT "默认时长（分钟）", -1, 12, 46, 82, 18, SS_CENTERIMAGE
    EDITTEXT IDC_TIMER_MINUTES, 100, 46, 64, 18, ES_NUMBER | WS_TABSTOP | WS_BORDER
    LTEXT "1–1440", -1, 174, 50, 84, 12
    LTEXT "显示样式", -1, 12, 80, 66, 18, SS_CENTERIMAGE
    COMBOBOX IDC_TIMER_STYLE, 82, 80, 182, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "呼出形态", -1, 12, 112, 66, 18, SS_CENTERIMAGE
    COMBOBOX IDC_TIMER_SHAPE, 82, 112, 182, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "↑/↓：±1 分钟；←/→：±10 秒；空格：暂停/继续。", -1, 12, 146, 252, 12
    LTEXT "到零后继续负计时。隐藏或切换窗口不停止计时。", -1, 12, 162, 252, 12
    DEFPUSHBUTTON "保存", IDOK, 142, 184, 56, 20
    PUSHBUTTON "取消", IDCANCEL, 208, 184, 56, 20
END
IDD_TIMER_TIME DIALOGEX 0, 0, 210, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置时长并重新开始"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "时长（分钟）", -1, 12, 18, 74, 18, SS_CENTERIMAGE
    EDITTEXT IDC_TIMER_MINUTES, 94, 18, 100, 18, ES_NUMBER | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "开始", IDOK, 74, 58, 56, 20
    PUSHBUTTON "取消", IDCANCEL, 140, 58, 56, 20
END
